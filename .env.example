# Solana Configuration
# Network: 'mainnet-beta', 'testnet', 'devnet', or 'localnet'
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Solana RPC endpoint URL
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# NOTE: The Lacus program ID is intentionally hardcoded in
# src/config/program-id.ts (currently BdRJSxsqbQZ12xuM9dcEQXuQ9R8AHvfTfMq6EppmEUoH)
# so a stale env override can never point production at the wrong program.
# There is no NEXT_PUBLIC_LACUS_PROGRAM_ID env var to set.
# Settlement is native SOL; there is no USDC mint or faucet in this build.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# KYC gate. Varsayılan kapalı: 'true' yapılmadıkça herkes geçer (no-op).
# Açıldığında kyc_status tablosunda cüzdan 'approved' değilse ihraç/satın alma engellenir.
NEXT_PUBLIC_KYC_ENABLED=false
